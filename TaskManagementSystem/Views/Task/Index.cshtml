@model TaskManagementSystem.ViewModels.TaskListViewModel
@{
    ViewData["Title"] = "Task List";
}

<!-- ===== PAGE HEADER ===== -->
<div class="card mb-3 shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
        <h2 class="mb-0 fw-semibold">
            <i class="bi bi-list-check text-primary"></i> Task List
        </h2>

        <div>
            <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-calendar3"></i> Calendar View
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create Task
            </a>
        </div>
    </div>
</div>

<!-- ===== FILTERS ===== -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">

                <div class="col-md-12">
                    <input type="text"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Search task title or description..."
                           value="@Model.SearchTerm" />
                </div>

                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        @foreach (var s in Model.StatusOptions)
                        {
                            @if (s.Key == Model.StatusFilter)
                            {
                                <option value="@s.Key" selected>@s.Value</option>
                            }
                            else
                            {
                                <option value="@s.Key">@s.Value</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="priorityFilter" class="form-select">
                        @foreach (var p in Model.PriorityOptions)
                        {
                            @if (p.Key == Model.PriorityFilter)
                            {
                                <option value="@p.Key" selected>@p.Value</option>
                            }
                            else
                            {
                                <option value="@p.Key">@p.Value</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="sortField" class="form-select">
                        <option value="DueDate">Due Date</option>
                        <option value="CreatedAt">Created Date</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="sortOrder" class="form-select">
                        <option value="asc">Ascending</option>
                        <option value="desc">Descending</option>
                    </select>
                </div>

                <div class="col-md-12">
                    <button class="btn btn-primary me-2">
                        <i class="bi bi-funnel"></i> Apply
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ===== TASK TABLE ===== -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    var isOverdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && task.Status != "Completed";

                    <tr class="@(isOverdue ? "table-danger-subtle" : "")">
                        <td class="fw-semibold">@task.Title</td>

                        <td class="text-muted">
                            @(string.IsNullOrEmpty(task.Description)
                                                    ? "—"
                                                    : task.Description.Length > 60
                                                    ? task.Description.Substring(0, 60) + "…"
                                                    : task.Description)
                        </td>

                        <td>
                            <span class="badge bg-secondary">@task.Status</span>
                        </td>

                        <td>
                            @if (task.Priority == 1)
                            {
                                <span class="badge bg-danger-subtle text-danger">High</span>
                            }
                            else if (task.Priority == 2)
                            {
                                <span class="badge bg-warning-subtle text-warning">Medium</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary">Low</span>
                            }
                        </td>

                        <td class="fw-semibold">
                            @(task.DueDate?.ToString("MMM dd, yyyy") ?? "—")
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger ms-1">Overdue</span>
                            }
                        </td>

                        <td class="text-muted">
                            @task.CreatedAt.ToString("MMM dd, yyyy")
                        </td>

                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>