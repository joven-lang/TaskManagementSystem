@using TaskManagementSystem.Helpers
@model TaskManagementSystem.ViewModels.TaskListViewModel

@{
    ViewData["Title"] = "Task List";
}

<link rel="stylesheet" href="~/css/tasklist.css" />

<div class="task-page">

    <!-- ===== HEADER ===== -->
    <div class="task-card task-header">
        <h2>📋 Task List</h2>
        <div class="task-actions">
            <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-secondary">
                📅 Calendar View
            </a>
            <a asp-action="Create" class="btn btn-primary">
                ➕ Create Task
            </a>
        </div>
    </div>

    <!-- ===== FILTERS ===== -->
    <div class="task-card task-filters">
        <form method="get" asp-action="Index">
            <div class="row g-2">

                <div class="col-md-12">
                    <input type="text"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Search task title or description..."
                           value="@Model.SearchTerm" />
                </div>

                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        @foreach (var s in Model.StatusOptions)
                        {
                            <option value="@s.Key" selected="@(s.Key == Model.StatusFilter)">
                                @s.Value
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="priorityFilter" class="form-select">
                        @foreach (var p in Model.PriorityOptions)
                        {
                            <option value="@p.Key" selected="@(p.Key == Model.PriorityFilter)">
                                @p.Value
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="sortField" class="form-select">
                        <option value="DueDate">Due Date</option>
                        <option value="CreatedAt">Created Date</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="sortOrder" class="form-select">
                        <option value="asc">Ascending</option>
                        <option value="desc">Descending</option>
                    </select>
                </div>

                <div class="col-md-12">
                    <button class="btn btn-primary me-2">Apply</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>

            </div>
        </form>
    </div>

    <!-- ===== TASK TABLE ===== -->
    <div class="task-card">
        <table class="task-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr class="@TaskDeadlineHelper.GetDeadlineClass(task.DueDate, task.Status)">
                        <td><strong>@task.Title</strong></td>

                        <td class="text-muted">
                            @(string.IsNullOrEmpty(task.Description)
                                                    ? "—"
                                                    : task.Description.Length > 60
                                                    ? task.Description.Substring(0, 60) + "…"
                                                    : task.Description)
                        </td>

                        <td>
                            <span class="badge-status
                                    @(task.Status == "Pending" ? "status-pending" :
                                                                    task.Status == "In Progress" ? "status-progress" :
                                                                    task.Status == "Overdue" ? "status-overdue" :
                                                                    "status-done")">
                                @task.Status
                            </span>
                        </td>

                        <td>
                            @if (task.Priority == 1)
                            {
                                <span class="badge-priority priority-high">High</span>
                            }
                            else if (task.Priority == 2)
                            {
                                <span class="badge-priority priority-medium">Medium</span>
                            }
                            else
                            {
                                <span class="badge-priority priority-low">Low</span>
                            }
                        </td>

                        <!-- ✅ SMART DEADLINE COLUMN -->
                        <td>
                            @task.DueDate?.ToString("MMM dd, yyyy")

                            @{
                                var label = TaskDeadlineHelper
                                .GetDeadlineLabel(task.DueDate, task.Status);
                            }

                            @if (!string.IsNullOrEmpty(label))
                            {
                                <span class="badge deadline-badge">@label</span>
                            }
                        </td>

                        <td class="text-muted">
                            @task.CreatedAt.ToString("MMM dd, yyyy")
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@task.Id"
                               class="view-btn">
                                👁
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
