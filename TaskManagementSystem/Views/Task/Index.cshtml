@model TaskManagementSystem.ViewModels.TaskListViewModel
@{
    ViewData["Title"] = "Task List";
}

<div class="row mb-3">
    <div class="col">
        <h2>Task List</h2>
    </div>
    <div class="col text-end">
        <!-- ✅ Calendar View Button --> <!-- NO CHANGE -->
        <a asp-controller="Calendar" asp-action="Index" class="btn btn-info">
            <i class="bi bi-calendar3"></i> Calendar View
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Task
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) 
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtering, Sorting, and Search Controls --> <!-- NO CHANGE - ENTIRE SECTION -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-3">
                <!-- Search -->
                <div class="col-md-12">
                    <label for="searchTerm" class="form-label fw-bold">
                        <i class="bi bi-search"></i> Search
                    </label>
                    <input type="text"
                           name="searchTerm"
                           id="searchTerm"
                           class="form-control"
                           placeholder="Search by title or description..."
                           value="@Model.SearchTerm">
                </div>

                <!-- Filters Row -->
                <div class="col-md-3">
                    <label for="statusFilter" class="form-label fw-bold">
                        <i class="bi bi-flag"></i> Status
                    </label>
                    <select name="statusFilter" id="statusFilter" class="form-select">
                        @foreach (var status in Model.StatusOptions)
                        {
                            <option value="@status.Key" selected="@(status.Key == Model.StatusFilter)">
                                @status.Value
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="priorityFilter" class="form-label fw-bold">
                        <i class="bi bi-exclamation-triangle"></i> Priority
                    </label>
                    <select name="priorityFilter" id="priorityFilter" class="form-select">
                        @foreach (var priority in Model.PriorityOptions)
                        {
                            <option value="@priority.Key" selected="@(priority.Key == Model.PriorityFilter)">
                                @priority.Value
                            </option>
                        }
                    </select>
                </div>

                <!-- Sort By -->
                <div class="col-md-3">
                    <label for="sortField" class="form-label fw-bold">
                        <i class="bi bi-funnel"></i> Sort By
                    </label>
                    <select name="sortField" id="sortField" class="form-select">
                        @foreach (var field in Model.SortFields)
                        {
                            <option value="@field.Key" selected="@(field.Key == Model.CurrentSortField)">
                                @field.Value
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="sortOrder" class="form-label fw-bold">
                        <i class="bi bi-sort-alpha-down"></i> Order
                    </label>
                    <select name="sortOrder" id="sortOrder" class="form-select">
                        @foreach (var order in Model.SortOrders)
                        {
                            <option value="@order.Key" selected="@(order.Key == Model.CurrentSortOrder)">
                                @order.Value
                            </option>
                        }
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="col-md-6">
                    <label class="form-label d-block">&nbsp;</label>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-arrow-repeat"></i> Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Clear All
                    </a>
                </div>

                <!-- Results Summary -->
                <div class="col-md-6 text-end">
                    <label class="form-label d-block">&nbsp;</label>
                    <span class="badge bg-info text-dark fs-6">
                        Showing @Model.Tasks.Count of @Model.TotalItems tasks
                    </span>
                </div>
            </div>

            <!-- Hidden fields to maintain page size -->
            <input type="hidden" name="page" value="@Model.CurrentPage" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </form>
    </div>
</div>

@if (Model.Tasks.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Created At</th>
                    <th>Created By</th> @* ADDED *@
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td>@task.Title</td> @* NO CHANGE *@
                        <td>@(task.Description?.Length > 50 ? task.Description.Substring(0, 50) + "..." : task.Description)</td> @* NO CHANGE *@
                        <td> @* NO CHANGE *@
                            @if (task.Status == "Completed")
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (task.Status == "InProgress")
                            {
                                <span class="badge bg-primary">In Progress</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </td>
                        <td> @* NO CHANGE *@
                            @if (task.Priority == 1)
                            {
                                <span class="badge bg-danger">High</span>
                            }
                            else if (task.Priority == 2)
                            {
                                <span class="badge bg-warning">Medium</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Low</span>
                            }
                        </td>
                        <td>@(task.DueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td> @* NO CHANGE *@
                        <td>@task.CreatedAt.ToString("MMM dd, yyyy")</td> @* NO CHANGE *@
                        <td> @* ADDED - Created By column *@
                            @if (!string.IsNullOrEmpty(task.CreatedByEmail))
                            {
                                <span class="text-primary">
                                    <i class="bi bi-person-circle"></i> @task.CreatedByEmail
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Unknown</span>
                            }
                        </td>
                        <td> @* NO CHANGE *@
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination --> <!-- NO CHANGE - ENTIRE PAGINATION SECTION STAYS THE SAME -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Task pagination">
            <ul class="pagination justify-content-center">
                <!-- First Page -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.CurrentSortField"
                       asp-route-sortOrder="@Model.CurrentSortOrder"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-priorityFilter="@Model.PriorityFilter"
                       asp-route-searchTerm="@Model.SearchTerm">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>

                <!-- Previous Page -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.CurrentSortField"
                       asp-route-sortOrder="@Model.CurrentSortOrder"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-priorityFilter="@Model.PriorityFilter"
                       asp-route-searchTerm="@Model.SearchTerm">
                        Previous
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortField="@Model.CurrentSortField"
                           asp-route-sortOrder="@Model.CurrentSortOrder"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-priorityFilter="@Model.PriorityFilter"
                           asp-route-searchTerm="@Model.SearchTerm">
                            @i
                        </a>
                    </li>
                }

                <!-- Next Page -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.CurrentSortField"
                       asp-route-sortOrder="@Model.CurrentSortOrder"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-priorityFilter="@Model.PriorityFilter"
                       asp-route-searchTerm="@Model.SearchTerm">
                        Next
                    </a>
                </li>

                <!-- Last Page -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sortField="@Model.CurrentSortField"
                       asp-route-sortOrder="@Model.CurrentSortOrder"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-priorityFilter="@Model.PriorityFilter"
                       asp-route-searchTerm="@Model.SearchTerm">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Size Selector -->
        <div class="text-center mb-3">
            <label class="me-2">Items per page:</label>
            <div class="btn-group" role="group">
                @foreach (var size in new[] { 5, 10, 25, 50 })
                {
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-pageSize="@size"
                       asp-route-sortField="@Model.CurrentSortField"
                       asp-route-sortOrder="@Model.CurrentSortOrder"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-priorityFilter="@Model.PriorityFilter"
                       asp-route-searchTerm="@Model.SearchTerm"
                       class="btn btn-sm @(size == Model.PageSize ? "btn-primary" : "btn-outline-primary")">
                        @size
                    </a>
                }
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter) || !string.IsNullOrEmpty(Model.PriorityFilter))
        {
            <text>No tasks found matching your filters. Try adjusting your search criteria.</text>
        }
        else
        {
            <text>No tasks found. Create your first task!</text>
        }
    </div>
}