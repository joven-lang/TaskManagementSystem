
@model TaskManagementSystem.ViewModels.TaskListViewModel
@{
    ViewData["Title"] = "Task List";
}

<div class="row mb-3">
    <div class="col">
        <h2>Task List</h2>
    </div>
    <div class="col text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Task
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Tasks.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>@task.Description</td>
                        <td>
                            @if (task.Status == "Completed")
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (task.Status == "InProgress")
                            {
                                <span class="badge bg-primary">In Progress</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </td>
                        <td>
                            @if (task.Priority == 1)
                            {
                                <span class="badge bg-danger">High</span>
                            }
                            else if (task.Priority == 2)
                            {
                                <span class="badge bg-warning">Medium</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Low</span>
                            }
                        </td>
                        <td>@(task.DueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                        <td>@task.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No tasks found. Create your first task!
    </div>
}