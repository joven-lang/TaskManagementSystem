@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Dashboard</h2>
            <p class="text-muted mb-0">Track your productivity and task progress</p>
        </div>
        <a asp-controller="Task" asp-action="Create" class="btn btn-primary">
            + Create Task
        </a>
    </div>

    <!-- STATS -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Total Tasks</small>
                    <h3 class="fw-bold">9</h3>
                    <div class="progress mt-2">
                        <div class="progress-bar" style="width:100%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Completed</small>
                    <h3 class="fw-bold text-success">10</h3>
                    <div class="progress mt-2">
                        <div class="progress-bar bg-success" style="width:22%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Pending</small>
                    <h3 class="fw-bold text-warning">6</h3>
                    <div class="progress mt-2">
                        <div class="progress-bar bg-warning" style="width:66%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Overdue</small>
                    <h3 class="fw-bold text-danger">1</h3>
                    <div class="progress mt-2">
                        <div class="progress-bar bg-danger" style="width:12%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="row">

        <!-- TASK TABLE -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold">
                    Recent Tasks
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>OJT</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td><span class="badge bg-secondary">Low</span></td>
                                <td>Feb 06, 2026</td>
                            </tr>
                            <tr>
                                <td>Report</td>
                                <td><span class="badge bg-success">Completed</span></td>
                                <td><span class="badge bg-danger">High</span></td>
                                <td>Feb 02, 2026</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white text-end">
                    <a asp-controller="Task" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        View All Tasks
                    </a>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="col-lg-4">

            <!-- CHART -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold">
                    Task Status Chart
                </div>
                <div class="card-body">
                    <canvas id="taskChart" height="200"></canvas>
                </div>
            </div>

            <!-- ACTIVITY -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold">
                    Recent Activity
                </div>
                <div class="card-body">
                    <div class="mb-2">✅ Completed task <b>Report</b></div>
                    <div class="mb-2">📝 Created task <b>OJT</b></div>
                    <div class="text-muted">⏰ Deadline approaching</div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- CHART SCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('taskChart');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'Pending', 'Overdue'],
            datasets: [{
                data: [2, 6, 1]
            }]
        }
    });
</script>
