@using TaskManagementSystem.Helpers
@model TaskManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-page">

    <!-- ===== HEADER ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title">Dashboard</h1>
            <p class="dashboard-subtitle">Track your productivity and task progress</p>
        </div>

        <a asp-controller="Task" asp-action="Create"
           class="btn btn-primary btn-create">
            + Create Task
        </a>
    </div>

    <!-- ===== STATS ===== -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Tasks</div>
                <div class="stat-number text-primary">@Model.TotalTasks</div>
                <div class="progress">
                    <div class="progress-bar bg-primary" style="width:100%"></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Completed</div>
                <div class="stat-number text-success">@Model.CompletedTasks</div>
                <div class="progress">
                    <div class="progress-bar bg-success"></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Pending</div>
                <div class="stat-number text-warning">@Model.PendingTasks</div>
                <div class="progress">
                    <div class="progress-bar bg-warning"></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Overdue</div>
                <div class="stat-number text-danger">@Model.OverdueTasks</div>
                <div class="progress">
                    <div class="progress-bar bg-danger"></div>
                </div>
            </div>
        </div>

    </div>

    <!-- ===== CONTENT ===== -->
    <div class="row g-4">

        <!-- RECENT TASKS -->
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    Recent Tasks
                </div>

                <div class="table-responsive">
                    <table class="table dashboard-table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Due</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.RecentTasks != null && Model.RecentTasks.Any())
                            {
                                foreach (var task in Model.RecentTasks)
                                {
                                    <tr class="@TaskDeadlineHelper.GetDeadlineClass(task.DueDate, task.Status)">
                                        <td class="fw-semibold">@task.Title</td>

                                        <td>
                                            <span class="badge @(task.Status == "Completed"
                                                                                                  ? "badge-completed"
                                                                                                  : task.Status == "Overdue"
                                                                                                      ? "badge-overdue"
                                                                                                      : "badge-pending")">
                                                @task.Status
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge
                                                        @(task.Priority == 1 ? "badge-high" :
                                                                                                    task.Priority == 2 ? "badge-medium" :
                                                                                                    "badge-low")">
                                                @(task.Priority == 1 ? "High" :
                                                                                        task.Priority == 2 ? "Medium" :
                                                                                        "Low")
                                            </span>
                                        </td>

                                        <td>
                                            @task.DueDate?.ToString("MMM dd, yyyy")

                                            @{
                                                var label = TaskDeadlineHelper
                                                .GetDeadlineLabel(task.DueDate, task.Status);
                                            }

                                            @if (!string.IsNullOrEmpty(label))
                                            {
                                                <span class="badge deadline-badge">@label</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">
                                        No recent tasks found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-end p-3">
                    <a asp-controller="Task" asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        View All Tasks
                    </a>
                </div>

            </div>
        </div>

        <!-- CHART -->
        <div class="col-lg-4">
            <div class="chart-card">
                <h6 class="fw-semibold mb-3">Task Status Chart</h6>
                <canvas id="taskChart" height="220"></canvas>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById('taskChart'), {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'Pending', 'Overdue'],
            datasets: [{
                data: [
                    @Model.CompletedTasks,
                    @Model.PendingTasks,
                    @Model.OverdueTasks
                ]
            }]
        }
    });
</script>
