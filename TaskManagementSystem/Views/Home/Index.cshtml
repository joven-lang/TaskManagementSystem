@{
    ViewData["Title"] = "Home";
}

<style>
    /* ===== HERO SECTION STYLES ===== */
    .hero-section {
        padding: 4rem 0;
        animation: fadeIn 0.8s ease-out;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 900;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #111827 0%, #4F46E5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.025em;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: #6B7280;
        line-height: 1.8;
        margin-bottom: 2rem;
        font-weight: 500;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .hero-image {
        animation: float 3s ease-in-out infinite;
    }

        .hero-image img {
            max-height: 350px;
            filter: drop-shadow(0 20px 40px rgba(99, 102, 241, 0.2));
        }

    /* ===== FEATURE CARDS ===== */
    .features-section {
        padding: 4rem 0;
    }

    .feature-card {
        background: white;
        border: 1px solid #E5E7EB;
        border-radius: 1.25rem;
        padding: 2.5rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #6366F1, #4F46E5);
            transform: scaleX(0);
            transition: transform 0.4s ease;
        }

        .feature-card:hover::before {
            transform: scaleX(1);
        }

        .feature-card:hover {
            transform: translateY(-12px) scale(1.03);
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.2);
            border-color: rgba(99, 102, 241, 0.3);
        }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 1.5rem;
        display: block;
        animation: float 3s ease-in-out infinite;
    }

    .feature-title {
        font-size: 1.375rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 1rem;
    }

    .feature-text {
        color: #6B7280;
        line-height: 1.7;
        font-size: 1rem;
    }

    /* ===== CTA SECTION ===== */
    .cta-section {
        padding: 4rem;
        background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
        border-radius: 1.5rem;
        color: white;
        text-align: center;
        box-shadow: 0 20px 40px rgba(99, 102, 241, 0.3);
        position: relative;
        overflow: hidden;
    }

        .cta-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

        .cta-section::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

    .cta-title {
        font-size: 2.5rem;
        font-weight: 900;
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
    }

    .cta-text {
        font-size: 1.125rem;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }

    .cta-section .btn {
        position: relative;
        z-index: 1;
    }

    .btn-cta {
        background: white;
        color: #6366F1;
        font-weight: 800;
        font-size: 1.125rem;
        padding: 1.125rem 2.5rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

        .btn-cta:hover {
            background: #F9FAFB;
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

    /* ===== ANIMATIONS ===== */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-15px);
        }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .hero-subtitle {
            font-size: 1.125rem;
        }

        .hero-buttons {
            flex-direction: column;
        }

            .hero-buttons .btn {
                width: 100%;
            }

        .hero-image img {
            max-height: 250px;
            margin-top: 2rem;
        }

        .feature-card {
            padding: 2rem;
        }

        .cta-section {
            padding: 3rem 2rem;
        }

        .cta-title {
            font-size: 2rem;
        }
    }
</style>

<div class="container">
    <!-- ===== HERO SECTION ===== -->
    <div class="hero-section">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="hero-title">
                    Organize Your Work.<br />
                    Finish Tasks Faster.
                </h1>
                <p class="hero-subtitle">
                    Task Manager helps you plan, track, and complete your tasks efficiently.
                    Stay productive and never miss a deadline.
                </p>
                <div class="hero-buttons">
                    <a asp-controller="Task" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-list-check"></i> View Tasks
                    </a>
                    <a asp-controller="Task" asp-action="Create" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-plus-circle"></i> Create Task
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center hero-image">
                <img src="https://cdn-icons-png.flaticon.com/512/906/906334.png"
                     class="img-fluid"
                     alt="Task Manager">
            </div>
        </div>
    </div>

    <!-- ===== FEATURES SECTION ===== -->
    <div class="features-section">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <span class="feature-icon">📝</span>
                    <h5 class="feature-title">Task Management</h5>
                    <p class="feature-text">
                        Create, update, and manage your tasks with ease. Organize with priorities and deadlines.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <span class="feature-icon">📅</span>
                    <h5 class="feature-title">Calendar View</h5>
                    <p class="feature-text">
                        See your tasks by date and track deadlines visually. Never miss important dates.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <span class="feature-icon">🔔</span>
                    <h5 class="feature-title">Notifications</h5>
                    <p class="feature-text">
                        Get notified about important updates and deadlines. Stay on top of your work.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== CALL TO ACTION ===== -->
    <div class="cta-section">
        <h3 class="cta-title">Ready to get started?</h3>
        <p class="cta-text">
            Create your tasks now and stay productive every day.
        </p>
        <a asp-controller="Task" asp-action="Create" class="btn btn-cta">
            <i class="bi bi-rocket-takeoff"></i> Get Started
        </a>
    </div>
</div>
