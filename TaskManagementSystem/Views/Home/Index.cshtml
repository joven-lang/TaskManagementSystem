@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <!-- HERO SECTION -->
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h1 class="fw-bold display-5">
                Organize Your Work.<br />
                Finish Tasks Faster.
            </h1>

            <p class="text-muted lead mt-3">
                Task Manager helps you plan, track, and complete your tasks efficiently.
                Stay productive and never miss a deadline.
            </p>

            <div class="mt-4">
                <a asp-controller="Task" asp-action="Index" class="btn btn-primary btn-lg me-2">
                    View Tasks
                </a>

                <a asp-controller="Task" asp-action="Create" class="btn btn-outline-secondary btn-lg">
                    Create Task
                </a>
            </div>
        </div>

        <div class="col-md-6 text-center">
            <img src="https://cdn-icons-png.flaticon.com/512/906/906334.png"
                 class="img-fluid"
                 style="max-height:300px;"
                 alt="Task Manager">
        </div>
    </div>

    <!-- FEATURES SECTION -->
    <div class="row text-center mt-5">

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">📝 Task Management</h5>
                    <p class="text-muted mt-2">
                        Create, update, and manage your tasks with ease.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">📅 Calendar View</h5>
                    <p class="text-muted mt-2">
                        See your tasks by date and track deadlines visually.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">🔔 Notifications</h5>
                    <p class="text-muted mt-2">
                        Get notified about important updates and deadlines.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- CALL TO ACTION -->
    <div class="text-center mt-5 p-5 bg-light rounded shadow-sm">
        <h3 class="fw-bold">Ready to get started?</h3>
        <p class="text-muted">
            Create your tasks now and stay productive every day.
        </p>

        <a asp-controller="Task" asp-action="Create" class="btn btn-success btn-lg">
            Get Started
        </a>
    </div>

</div>
