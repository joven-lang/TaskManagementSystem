@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <!-- HERO SECTION -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to Task Manager</h1>
        <p class="lead text-muted">
            Manage your tasks, track your progress, and stay organized every day.
        </p>

        <div class="mt-4">
            <a asp-controller="Task" asp-action="Index" class="btn btn-primary btn-lg me-2">
                View My Tasks
            </a>

            <a asp-controller="Task" asp-action="Create" class="btn btn-success btn-lg">
                Create New Task
            </a>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row text-center">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body">
                    <h5 class="text-muted">Total Tasks</h5>
                    <h2 class="fw-bold">0</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body">
                    <h5 class="text-muted">Completed Tasks</h5>
                    <h2 class="fw-bold text-success">0</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body">
                    <h5 class="text-muted">Pending Tasks</h5>
                    <h2 class="fw-bold text-warning">0</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- ROLE BASED SECTION -->
    @if (User.IsInRole("Admin"))
    {
        <div class="text-center mt-5">
            <h4 class="fw-bold">Admin Panel</h4>
            <a asp-controller="User" asp-action="Index" class="btn btn-warning mt-2">
                Manage Users
            </a>
        </div>
    }

</div>
