@model List<TaskManagementSystem.Models.NotificationEntity>
@{
    ViewData["Title"] = "Notifications";
}

<link rel="stylesheet" href="~/css/notifications.css" />

<div class="container notification-page">
    <!-- ===== NOTIFICATION HEADER ===== -->
    <div class="notification-header">
        <h2>
            <i class="bi bi-bell-fill"></i> Notifications
        </h2>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                <button type="submit" class="btn">
                    <i class="bi bi-check-all"></i> Mark All as Read
                </button>
            </form>
        }
    </div>

    <!-- ===== NOTIFICATION LIST ===== -->
    @if (!Model.Any())
    {
        <div class="notification-empty">
            <i class="bi bi-bell-slash"></i>
            <h4>No notifications yet</h4>
            <p>When you have new notifications, they'll appear here.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in Model)
            {
                <div class="notification-card @(!notification.IsRead ? "unread" : "")">
                    <!-- Left: Status Badge -->
                    <div class="notification-left">
                        @if (notification.Type == "Overdue")
                        {
                            <span class="status-badge overdue">
                                <i class="bi bi-exclamation-triangle-fill"></i> Overdue
                            </span>
                        }
                        else if (notification.Type == "DueToday")
                        {
                            <span class="status-badge today">
                                <i class="bi bi-calendar-check"></i> Today
                            </span>
                        }
                        else if (notification.Type == "DueTomorrow")
                        {
                            <span class="status-badge tomorrow">
                                <i class="bi bi-calendar-event"></i> Tomorrow
                            </span>
                        }
                    </div>

                    <!-- Body: Message and Task Link -->
                    <div class="notification-body">
                        <div class="notification-title">@notification.Message</div>
                        @if (notification.Task != null)
                        {
                            <div class="notification-sub">
                                <a asp-controller="Task" asp-action="Details" asp-route-id="@notification.TaskId">
                                    <i class="bi bi-eye"></i> View Task: @notification.Task.Title
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Right: Timestamp and Actions -->
                    <div class="notification-right">
                        <div class="notification-time">
                            @notification.CreatedAt.ToString("MMM dd, yyyy")
                            <br />
                            @notification.CreatedAt.ToString("h:mm tt")
                        </div>
                        @if (!notification.IsRead)
                        {
                            <div class="notification-actions">
                                <form asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                    <button type="submit" class="mark-read-btn">
                                        <i class="bi bi-check-circle"></i> Mark Read
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Additional inline animations for this page */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
