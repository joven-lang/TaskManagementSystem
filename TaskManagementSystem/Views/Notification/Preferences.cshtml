@{
    ViewData["Title"] = "Notification Preferences";
}

<div class="container mt-4">
    <h2><i class="bi bi-gear"></i> Notification Preferences</h2>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Current Settings</h5>
            <div class="alert alert-info">
                <p class="mb-2"><strong>Notification Frequency:</strong> Every hour</p>
                <p class="mb-2"><strong>Notifications for:</strong></p>
                <ul>
                    <li>Tasks due tomorrow (24 hours before)</li>
                    <li>Tasks due today</li>
                    <li>Overdue tasks</li>
                </ul>
            </div>
            <p class="text-muted">
                <i class="bi bi-info-circle"></i>
                Notification settings are managed automatically to keep you updated on important task deadlines.
            </p>
        </div>
    </div>
</div>