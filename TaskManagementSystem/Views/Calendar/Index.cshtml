@{
    ViewData["Title"] = "Calendar View";
}

<!-- ===== PAGE HEADER ===== -->
<div class="card mb-3 shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
        <h2 class="mb-0 fw-semibold">
            <i class="bi bi-calendar-event text-primary"></i> Task Calendar
        </h2>

        <div>
            <a asp-controller="Task" asp-action="Create" class="btn btn-primary me-2">
                <i class="bi bi-plus-circle"></i> Create Task
            </a>
            <a asp-controller="Task" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-list-ul"></i> List View
            </a>
        </div>
    </div>
</div>

<!-- ===== PRIORITY LEGEND ===== -->
<div class="card mb-3">
    <div class="card-body py-2">
        <strong class="me-2">Priority:</strong>

        <span class="badge legend-high me-2">High</span>
        <span class="badge legend-medium me-2">Medium</span>
        <span class="badge legend-low">Low</span>
    </div>
</div>

<!-- ===== CALENDAR ===== -->
<div class="card shadow-sm">
    <div class="card-body">
        <div id="calendar"></div>
    </div>
</div>

<!-- ===== TASK DETAILS MODAL ===== -->
<div class="modal fade" id="taskDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskModalTitle">Task Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="taskModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" id="viewTaskDetailsBtn" class="btn btn-info">
                    <i class="bi bi-eye"></i> View
                </a>
                <a href="#" id="editTaskBtn" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />

    <style>
        /* ===== LEGEND COLORS (SOFT) ===== */
        .legend-high {
            background: rgba(220,53,69,.15);
            color: #842029;
        }

        .legend-medium {
            background: rgba(255,193,7,.2);
            color: #664d03;
        }

        .legend-low {
            background: rgba(13,110,253,.15);
            color: #084298;
        }

        /* ===== CALENDAR ===== */
        #calendar {
            font-size: 0.9rem;
        }

        .fc-toolbar-title {
            font-size: 1.4rem !important;
            font-weight: 600;
        }

        .fc-button {
            background: #f8f9fa !important;
            border: 1px solid #dee2e6 !important;
            color: #212529 !important;
            font-size: 0.85rem;
        }

        .fc-button-active {
            background: #0d6efd !important;
            color: #fff !important;
            border-color: #0d6efd !important;
        }

        .fc-day-today {
            background: rgba(13,110,253,.06) !important;
        }

        .fc-event {
            border: none !important;
            border-radius: 6px;
            padding: 3px 6px;
            font-size: 0.85rem;
            font-weight: 500;
        }

            .fc-event:hover {
                opacity: .9;
            }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const calendarEl = document.getElementById('calendar');
            const modal = new bootstrap.Modal(document.getElementById('taskDetailsModal'));

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                displayEventTime: false,

                events: function (info, success, failure) {
                    fetch('@Url.Action("GetEvents", "Calendar")?start=' + info.startStr + '&end=' + info.endStr)
                        .then(r => r.json())
                        .then(success)
                        .catch(failure);
                },

                eventClick: function (info) {
                    info.jsEvent.preventDefault();
                    loadTask(info.event.id);
                }
            });

            calendar.render();

            function loadTask(id) {
                modal.show();

                fetch('@Url.Action("GetTaskDetails", "Calendar")/' + id)
                    .then(r => r.json())
                    .then(d => {
                        document.getElementById('taskModalTitle').innerText = d.title;
                        document.getElementById('taskModalBody').innerHTML = `
                            <p><strong>Status:</strong> <span class="badge bg-primary">${d.status}</span></p>
                            <p><strong>Priority:</strong> <span class="badge bg-secondary">${d.priority}</span></p>
                            ${d.description ? `<p class="mt-3">${d.description}</p>` : ''}
                        `;
                        document.getElementById('viewTaskDetailsBtn').href = d.detailsUrl;
                        document.getElementById('editTaskBtn').href = d.editUrl;
                    });
            }
        });
    </script>
}
